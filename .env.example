EXPERT_DB_DATABASE=expert2
EXPERT_DB_USERNAME=root
EXPERT_DB_PASSWORD=

LRD_DB_HOST=127.0.0.1
LRD_DB_PORT=3306
LRD_DB_DATABASE=lrdsystem2
LRD_DB_USERNAME=root
LRD_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=43200
